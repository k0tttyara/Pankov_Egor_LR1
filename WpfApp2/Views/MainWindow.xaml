<Window x:Class="WpfApp2.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Инженерный калькулятор" 
        Height="650" Width="800" 
        MinHeight="550" MinWidth="700"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="CalcButton" TargetType="Button">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Height" Value="55"/>
            <Setter Property="Background" Value="#FF2D2D30"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF3F3F46"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#FF1B1B1E"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource CalcButton}">
            <Setter Property="Background" Value="#FF007ACC"/>
            <Setter Property="FontSize" Value="20"/>
        </Style>

        <Style x:Key="EngineerButton" TargetType="Button" BasedOn="{StaticResource CalcButton}">
            <Setter Property="Background" Value="#FF6A4E9B"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>

        <Style x:Key="ToggleEngineerStyle" TargetType="ToggleButton">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Width" Value="150"/>
            <Setter Property="Background" Value="#FF6A4E9B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF9B59B6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Content" Value="🔧 Инженерный режим"/>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#FF9B59B6"/>
                    <Setter Property="Content" Value="📱 Обычный режим"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF8E44AD"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="#FF252526">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="260"/>
        </Grid.ColumnDefinitions>

        <!-- ОСНОВНАЯ ПАНЕЛЬ -->
        <Grid Grid.Column="0" Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                <ToggleButton x:Name="EngineerToggle" Style="{StaticResource ToggleEngineerStyle}"/>
                <TextBlock Text="КАЛЬКУЛЯТОР" 
                           VerticalAlignment="Center" Margin="20,0,0,0"
                           Foreground="#FF8A8A8A" FontSize="14" FontWeight="SemiBold"/>
            </StackPanel>

            <Border Grid.Row="1" Background="#FF1E1E1E" CornerRadius="10" 
                    BorderBrush="#FF3F3F46" BorderThickness="1" Margin="0,5,0,15" Height="100">
                <Grid Margin="15,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="ExpressionPreview" Grid.Row="0" 
                               Text="0" Foreground="#FF8A8A8A" 
                               FontSize="16" HorizontalAlignment="Right"/>

                    <TextBlock x:Name="ResultDisplay" Grid.Row="1" 
                               Text="0" Foreground="White" 
                               FontSize="36" FontWeight="Bold" 
                               HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <UniformGrid Rows="5" Columns="4" Margin="0,5">
                        <Button x:Name="BtnClear" Style="{StaticResource CalcButton}" Content="C"/>
                        <Button x:Name="BtnSign" Style="{StaticResource CalcButton}" Content="±"/>
                        <Button x:Name="BtnPercent" Style="{StaticResource CalcButton}" Content="%"/>
                        <Button x:Name="BtnDivide" Style="{StaticResource ActionButton}" Content="÷"/>

                        <Button x:Name="Btn7" Style="{StaticResource CalcButton}" Content="7"/>
                        <Button x:Name="Btn8" Style="{StaticResource CalcButton}" Content="8"/>
                        <Button x:Name="Btn9" Style="{StaticResource CalcButton}" Content="9"/>
                        <Button x:Name="BtnMultiply" Style="{StaticResource ActionButton}" Content="×"/>

                        <Button x:Name="Btn4" Style="{StaticResource CalcButton}" Content="4"/>
                        <Button x:Name="Btn5" Style="{StaticResource CalcButton}" Content="5"/>
                        <Button x:Name="Btn6" Style="{StaticResource CalcButton}" Content="6"/>
                        <Button x:Name="BtnMinus" Style="{StaticResource ActionButton}" Content="-"/>

                        <Button x:Name="Btn1" Style="{StaticResource CalcButton}" Content="1"/>
                        <Button x:Name="Btn2" Style="{StaticResource CalcButton}" Content="2"/>
                        <Button x:Name="Btn3" Style="{StaticResource CalcButton}" Content="3"/>
                        <Button x:Name="BtnPlus" Style="{StaticResource ActionButton}" Content="+"/>

                        <Button x:Name="Btn0" Style="{StaticResource CalcButton}" Content="0"/>
                        <Button x:Name="Btn00" Style="{StaticResource CalcButton}" Content="00"/>
                        <Button x:Name="BtnComma" Style="{StaticResource CalcButton}" Content=","/>
                        <Button x:Name="BtnEquals" Style="{StaticResource ActionButton}" Content="="/>
                    </UniformGrid>

                    <UniformGrid x:Name="EngineerPanel" Rows="2" Columns="6" Margin="0,5" Visibility="Collapsed">
                        <Button x:Name="BtnSin" Style="{StaticResource EngineerButton}" Content="sin"/>
                        <Button x:Name="BtnCos" Style="{StaticResource EngineerButton}" Content="cos"/>
                        <Button x:Name="BtnTan" Style="{StaticResource EngineerButton}" Content="tan"/>
                        <Button x:Name="BtnSqrt" Style="{StaticResource EngineerButton}" Content="√"/>
                        <Button x:Name="BtnSquare" Style="{StaticResource EngineerButton}" Content="x²"/>
                        <Button x:Name="BtnPow" Style="{StaticResource EngineerButton}" Content="xʸ"/>

                        <Button x:Name="BtnLog" Style="{StaticResource EngineerButton}" Content="log"/>
                        <Button x:Name="BtnLn" Style="{StaticResource EngineerButton}" Content="ln"/>
                        <Button x:Name="BtnPi" Style="{StaticResource EngineerButton}" Content="π"/>
                        <Button x:Name="BtnE" Style="{StaticResource EngineerButton}" Content="e"/>
                        <Button x:Name="BtnOpenParen" Style="{StaticResource EngineerButton}" Content="("/>
                        <Button x:Name="BtnCloseParen" Style="{StaticResource EngineerButton}" Content=")"/>
                    </UniformGrid>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <GridSplitter Grid.Column="1" Width="3" Background="#FF3F3F46" 
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

        <Border Grid.Column="2" Background="#FF1E1E1E">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#FF2D2D30" CornerRadius="8" Padding="10,8" Margin="0,0,0,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="📜 История" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                        <Button x:Name="ClearHistoryBtn" Grid.Column="1" Content="🗑️" Background="Transparent" 
                                BorderThickness="0" Foreground="#FF8A8A8A" Cursor="Hand" FontSize="16"/>
                    </Grid>
                </Border>

                <ListBox x:Name="HistoryList" Grid.Row="1" Background="Transparent" 
                         BorderThickness="0" Foreground="#FFC0C0C0" FontSize="14">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#FF2D2D30" CornerRadius="6" Margin="0,5" Padding="10,8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="{Binding Expression}" 
                                               Foreground="#FF8A8A8A" FontSize="12"/>
                                    <TextBlock Grid.Row="1" Text="{Binding Result}" 
                                               Foreground="White" FontSize="18" FontWeight="Bold"
                                               Margin="0,5,0,0"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="2" Background="#FF2D2D30" CornerRadius="8" Margin="0,10,0,0" Padding="8">
                    <TextBlock Text="💡 Двойной клик для вставки" 
                               Foreground="#FF6A6A6A" FontSize="11" TextWrapping="Wrap"
                               TextAlignment="Center"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>